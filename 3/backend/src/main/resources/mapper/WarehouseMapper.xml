<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wms.mapper.WarehouseMapper">

    <resultMap id="BaseResultMap" type="com.wms.entity.Warehouse">
        <id column="id" property="id"/>
        <result column="warehouse_code" property="warehouseCode"/>
        <result column="warehouse_name" property="warehouseName"/>
        <result column="warehouse_type" property="warehouseType"/>
        <result column="address" property="address"/>
        <result column="manager" property="manager"/>
        <result column="phone" property="phone"/>
        <result column="area" property="area"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, warehouse_code, warehouse_name, warehouse_type, address, manager, phone, area, status,
        remark, create_time, update_time, create_by, update_by
    </sql>

    <insert id="insert" parameterType="com.wms.entity.Warehouse" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO wms_warehouse
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="warehouseCode != null">warehouse_code,</if>
            <if test="warehouseName != null">warehouse_name,</if>
            <if test="warehouseType != null">warehouse_type,</if>
            <if test="address != null">address,</if>
            <if test="manager != null">manager,</if>
            <if test="phone != null">phone,</if>
            <if test="area != null">area,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="warehouseCode != null">#{warehouseCode},</if>
            <if test="warehouseName != null">#{warehouseName},</if>
            <if test="warehouseType != null">#{warehouseType},</if>
            <if test="address != null">#{address},</if>
            <if test="manager != null">#{manager},</if>
            <if test="phone != null">#{phone},</if>
            <if test="area != null">#{area},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.wms.entity.Warehouse">
        UPDATE wms_warehouse
        <set>
            <if test="warehouseCode != null">warehouse_code = #{warehouseCode},</if>
            <if test="warehouseName != null">warehouse_name = #{warehouseName},</if>
            <if test="warehouseType != null">warehouse_type = #{warehouseType},</if>
            <if test="address != null">address = #{address},</if>
            <if test="manager != null">manager = #{manager},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="area != null">area = #{area},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <select id="selectById" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM wms_warehouse
        WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM wms_warehouse
        <where>
            <if test="status != null">AND status = #{status}</if>
        </where>
        ORDER BY create_time DESC
    </select>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM wms_warehouse WHERE id = #{id}
    </delete>

</mapper>
