<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wms.mapper.ProductMapper">

    <resultMap id="BaseResultMap" type="com.wms.entity.Product">
        <id column="id" property="id"/>
        <result column="product_code" property="productCode"/>
        <result column="product_name" property="productName"/>
        <result column="barcode" property="barcode"/>
        <result column="specification" property="specification"/>
        <result column="unit" property="unit"/>
        <result column="category" property="category"/>
        <result column="brand" property="brand"/>
        <result column="weight" property="weight"/>
        <result column="volume" property="volume"/>
        <result column="price" property="price"/>
        <result column="shelf_life" property="shelfLife"/>
        <result column="warning_days" property="warningDays"/>
        <result column="min_stock" property="minStock"/>
        <result column="max_stock" property="maxStock"/>
        <result column="storage_condition" property="storageCondition"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, product_code, product_name, barcode, specification, unit, category, brand, weight, volume,
        price, shelf_life, warning_days, min_stock, max_stock, storage_condition, status, remark,
        create_time, update_time, create_by, update_by
    </sql>

    <insert id="insert" parameterType="com.wms.entity.Product" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO wms_product
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="productCode != null">product_code,</if>
            <if test="productName != null">product_name,</if>
            <if test="barcode != null">barcode,</if>
            <if test="specification != null">specification,</if>
            <if test="unit != null">unit,</if>
            <if test="category != null">category,</if>
            <if test="brand != null">brand,</if>
            <if test="weight != null">weight,</if>
            <if test="volume != null">volume,</if>
            <if test="price != null">price,</if>
            <if test="shelfLife != null">shelf_life,</if>
            <if test="warningDays != null">warning_days,</if>
            <if test="minStock != null">min_stock,</if>
            <if test="maxStock != null">max_stock,</if>
            <if test="storageCondition != null">storage_condition,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="productCode != null">#{productCode},</if>
            <if test="productName != null">#{productName},</if>
            <if test="barcode != null">#{barcode},</if>
            <if test="specification != null">#{specification},</if>
            <if test="unit != null">#{unit},</if>
            <if test="category != null">#{category},</if>
            <if test="brand != null">#{brand},</if>
            <if test="weight != null">#{weight},</if>
            <if test="volume != null">#{volume},</if>
            <if test="price != null">#{price},</if>
            <if test="shelfLife != null">#{shelfLife},</if>
            <if test="warningDays != null">#{warningDays},</if>
            <if test="minStock != null">#{minStock},</if>
            <if test="maxStock != null">#{maxStock},</if>
            <if test="storageCondition != null">#{storageCondition},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.wms.entity.Product">
        UPDATE wms_product
        <set>
            <if test="productCode != null">product_code = #{productCode},</if>
            <if test="productName != null">product_name = #{productName},</if>
            <if test="barcode != null">barcode = #{barcode},</if>
            <if test="specification != null">specification = #{specification},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="category != null">category = #{category},</if>
            <if test="brand != null">brand = #{brand},</if>
            <if test="weight != null">weight = #{weight},</if>
            <if test="volume != null">volume = #{volume},</if>
            <if test="price != null">price = #{price},</if>
            <if test="shelfLife != null">shelf_life = #{shelfLife},</if>
            <if test="warningDays != null">warning_days = #{warningDays},</if>
            <if test="minStock != null">min_stock = #{minStock},</if>
            <if test="maxStock != null">max_stock = #{maxStock},</if>
            <if test="storageCondition != null">storage_condition = #{storageCondition},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <select id="selectById" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM wms_product
        WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM wms_product
        <where>
            <if test="productCode != null and productCode != ''">AND product_code LIKE CONCAT('%', #{productCode}, '%')</if>
            <if test="productName != null and productName != ''">AND product_name LIKE CONCAT('%', #{productName}, '%')</if>
            <if test="category != null and category != ''">AND category = #{category}</if>
            <if test="brand != null and brand != ''">AND brand = #{brand}</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
        ORDER BY create_time DESC
        <if test="query != null">
            LIMIT #{query.pageNum}, #{query.pageSize}
        </if>
    </select>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM wms_product WHERE id = #{id}
    </delete>

</mapper>