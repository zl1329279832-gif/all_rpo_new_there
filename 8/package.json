{
  "name": "group-ops-platform",
  "version": "1.0.0",
  "description": "面向集团业务的多应用运营中台",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,bff -c blue,green \"npm run dev:web\" \"npm run dev:bff\"",
    "dev:web": "npm run dev -w @platform/web",
    "dev:bff": "npm run dev -w @platform/bff",
    "build": "npm run build -w @platform/web && npm run build -w @platform/bff",
    "build:web": "npm run build -w @platform/web",
    "build:bff": "npm run build -w @platform/bff",
    "start:bff": "npm run start -w @platform/bff",
    "preview": "npm run preview -w @platform/web",
    "test": "npm run test -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
